{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos base de Ichibot (chat + overlay + sidecar del agente)",
  "windows": ["chat", "mochi-overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/agent",
          "sidecar": true
        }
      ]
    },
    "process:default",
    "opener:default"
  ]
}
